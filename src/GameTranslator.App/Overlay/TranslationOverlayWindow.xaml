<Window x:Class="GameTranslator.App.Overlay.TranslationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GameTranslator Overlay"
        Width="520"
        Height="210"
        MinWidth="320"
        MinHeight="140"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="OverlayShell"
            BorderBrush="#718096"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="10,6"
                    Background="#202733"
                    CornerRadius="5,5,0,0"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            x:Name="TranslateButton"
                            MinWidth="78"
                            Padding="14,6"
                            FontWeight="SemiBold"
                            Click="TranslateButton_Click"
                            Content="DỊCH" />
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#D7DEE8"
                               Text="GameTranslator" />
                    <Button Grid.Column="2"
                            Width="48"
                            Height="30"
                            Margin="4,0,0,0"
                            Click="HideButton_Click"
                            Content="Ẩn"
                            ToolTip="Ẩn overlay" />
                    <Button Grid.Column="3"
                            Width="38"
                            Height="30"
                            Margin="4,0,0,0"
                            Click="CloseButton_Click"
                            Content="X"
                            ToolTip="Ẩn overlay" />
                </Grid>
            </Border>

            <TextBox Grid.Row="1"
                     x:Name="TranslationTextBox"
                     Margin="16,12,16,8"
                     Padding="0"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="#FFFFFF"
                     FontFamily="Segoe UI"
                     FontSize="23"
                     Text="Sẵn sàng dịch." />

            <Grid Grid.Row="2" Margin="16,0,8,8">
                <TextBlock x:Name="StatusTextBlock"
                           Margin="0,0,18,0"
                           VerticalAlignment="Center"
                           Foreground="#C8D1DD"
                           FontSize="12"
                           Text="Bấm DỊCH để chạy một lần." />
                <ResizeGrip HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Foreground="#C8D1DD" />
            </Grid>
        </Grid>
    </Border>
</Window>
