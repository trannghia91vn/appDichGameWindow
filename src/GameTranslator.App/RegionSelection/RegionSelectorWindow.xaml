<Window x:Class="GameTranslator.App.RegionSelection.RegionSelectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn vùng"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        Cursor="Cross"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Canvas x:Name="OverlayCanvas"
            Background="Transparent"
            MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
            MouseMove="OverlayCanvas_MouseMove"
            MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
        <Path x:Name="DimmingPath"
              Fill="#99000000"
              IsHitTestVisible="False" />

        <Rectangle x:Name="SelectionRectangle"
                   Visibility="Collapsed"
                   Fill="#18FFFFFF"
                   Stroke="#35B8FF"
                   StrokeThickness="2"
                   IsHitTestVisible="False" />

        <Border x:Name="SizeLabel"
                Visibility="Collapsed"
                Padding="7,4"
                Background="#E61B2430"
                BorderBrush="#35B8FF"
                BorderThickness="1"
                CornerRadius="3"
                IsHitTestVisible="False">
            <TextBlock x:Name="SizeText"
                       Foreground="White"
                       FontFamily="Consolas"
                       FontSize="13" />
        </Border>

        <Border Canvas.Left="20"
                Canvas.Top="20"
                Padding="10,7"
                Background="#E61B2430"
                CornerRadius="4"
                IsHitTestVisible="False">
            <TextBlock Foreground="White"
                       Text="Kéo chuột để chọn vùng. Nhấn Esc để hủy." />
        </Border>
    </Canvas>
</Window>
